{
  "id": "studio",
  "name": "内容台",
  "version": "0.4.3",
  "description": "easyop 的内容生产工作台：选题台账 → AI 生成（标题/正文/内容优化）→ 导出稿件 / 平台发布（单个排版 HTML）。随 easyop 发布的内置插件。",
  "main": "index.js",
  "activationEvents": [
    "onPage:studio.board"
  ],
  "contributes": {
    "commands": [
      {
        "id": "studio.state",
        "title": "内容台状态",
        "keywords": ["状态", "state", "zt"]
      },
      {
        "id": "studio.topics.list",
        "title": "列出选题",
        "keywords": ["选题", "列表", "xuanti", "xt"]
      },
      {
        "id": "studio.topics.save",
        "title": "保存选题",
        "keywords": ["选题", "保存", "baocun", "bc"]
      },
      {
        "id": "studio.topics.remove",
        "title": "删除选题",
        "keywords": ["选题", "删除", "shanchu", "sc"]
      },
      {
        "id": "studio.stage.advance",
        "title": "推进阶段",
        "keywords": ["推进", "阶段", "tuiin", "tj"]
      },
      {
        "id": "studio.gen.title",
        "title": "生成标题候选",
        "keywords": ["标题", "生成", "biaoti", "bt", "title"]
      },
      {
        "id": "studio.gen.body",
        "title": "生成正文",
        "keywords": ["正文", "生成", "zhengwen", "zw", "body"]
      },
      {
        "id": "studio.gen.humanize",
        "title": "内容优化",
        "keywords": ["内容优化", "去ai味", "humanize", "润色", "runse", "rs"]
      },
      {
        "id": "studio.gen.intel",
        "title": "生成情报卡",
        "keywords": ["情报卡", "生成", "qingbaoka", "qb"]
      },
      {
        "id": "studio.gen.all",
        "title": "一键执行",
        "keywords": ["一键执行", "全自动", "yijianzhixing", "yjzx"]
      },
      {
        "id": "studio.export",
        "title": "导出稿件",
        "keywords": ["导出", "export", "daochu", "dc"]
      },
      {
        "id": "studio.publish.html",
