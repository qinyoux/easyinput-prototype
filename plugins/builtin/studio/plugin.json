      {
        "id": "studio.set_focus",
        "title": "设置旋钮焦点",
        "keywords": ["焦点", "focus", "jiaodian", "jd"]
      }
    ],
    "tools": [],
    "pages": [
      {
        "id": "studio.board",
        "title": "内容台",
        "icon": "board",
        "order": 50,
        "keywords": ["内容台", "studio", "写稿", "看板", "nrt"]
      }
    ]
