      {
        "id": "studio.open.dir",
        "title": "打开产物目录",
        "keywords": ["打开目录", "目录", "open", "mulu", "ml"]
      },
      {
        "id": "studio.doctor",
        "title": "内容台自检",
        "keywords": ["自检", "环境", "doctor", "zijan", "zj"]
      },
      {
        "id": "studio.quick_action",
