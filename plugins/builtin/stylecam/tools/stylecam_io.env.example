# StyleCam 配置 v2 模板。复制为 stylecam_io.env 后填写；不要提交真 Key。
# 优先级：CLI > stylecam.job > stylecam.config > 本文件 > provider 默认。
# Key 例外：人工 --api-key > IMAGE_API_KEY/ARK_API_KEY > Ark 的 easyop llm_api_key 旧兜底。

PROVIDER=easysu
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

RESOLUTION=1K
WIDTH=1024
HEIGHT=1024
FORMAT=auto
QUALITY=
N=1
HTTP_TIMEOUT_SECS=120
RETRY_COUNT=1
OUT_DIR=

# 支持 provider：easysu / ark / openai_compat / zhipu
# 推荐由设置面板通过临时 storage secret 调用：
# key set-env --from-storage-key stylecam.secret --nonce <nonce>
# 人工 CLI 仍可用 key set-env --value <key>，但 Key 会出现在进程参数中，不推荐。
