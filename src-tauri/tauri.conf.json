{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easyop",
  "version": "0.41.15",
  "identifier": "com.easyop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "easyop · 按键配置",
        "width": 780,
        "height": 720,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2026 easyop",
    "category": "Utility",
    "shortDescription": "easyop · ESP32 按键配置与语音输入工具",
    "longDescription": "easyop 是一款配合 ESP32_S3_BOT 使用的桌面配置工具，支持按键方案管理、语音输入（ASR）与 LLM 文本编辑。"
  }
}
