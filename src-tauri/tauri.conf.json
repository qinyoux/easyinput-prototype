{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easyop",
  "version": "0.2.0",
  "identifier": "com.easyop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "easyop · 按键配置",
        "width": 780,
        "height": 720,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
